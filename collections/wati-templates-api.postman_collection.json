          "id": "c34ee787-8bbf-4ec0-8b03-9cd914c3a3ad",
          "name": "Send a WhatsApp template message",
          "request": {
            "name": "Send a WhatsApp template message",
            "description": {
              "content": "Send a pre-approved WhatsApp template message to a contact identified by phone number.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sendTemplateMessage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "whatsappNumber",
                  "value": "<string>",
                  "description": "(Required) Destination WhatsApp number with country code."
                }
              ],
              "variable": [
                {
                  "description": "WATI tenant / workspace identifier assigned to the account.",
                  "type": "any",
                  "value": "{{tenantId}}",
                  "key": "tenantId"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template_name\": \"<string>\",\n  \"broadcast_name\": \"<string>\",\n  \"parameters\": [\n    {\n      \"name\": \"<string>\",\n      \"value\": \"<string>\"\n    },\n    {\n      \"name\": \"<string>\",\n      \"value\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "7d61f2a0-43c5-477c-9f16-67a503fbbbec",
              "name": "Template message accepted for delivery.",
              "originalRequest": {
